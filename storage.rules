rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Face ID samples: strictly isolated to the authenticated user
    match /faceProfiles/{userId}/{fileName} {
      allow read, write: if request.auth != null
                         && request.auth.uid == userId;
    }

    // Default deny all other paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

